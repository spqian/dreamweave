# dependencies
node_modules/

# Python adapter bytecode — never package local paths/caches
__pycache__/
*.py[cod]

# per-user runtime data (db, model cache, rendered viz) — never commit
/data/
*.db
*.db-wal
*.db-shm

# transformers.js model cache if placed locally
model-cache/
.hf-cache/

# local working notes / session handoff — never commit
HANDOFF.md

# OS / editor
.DS_Store
Thumbs.db
*.log

# secrets — never commit
.env
.env.*
!.env.example

_synthwork/

# local scratch: underscore-prefixed working dirs/files & harness snapshots — never commit
/_*
snap-*.json
